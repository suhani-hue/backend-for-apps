# ─── .env.example ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your real .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, great for local dev and low-traffic deploys):
DATABASE_URL="file:./dev.db"
# PostgreSQL (swap when you need a real server):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_me_with_a_long_random_string"
JWT_EXPIRES_IN="15m"
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:3000"

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth app at: github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: console.cloud.google.com
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Where your frontend is running (for OAuth redirects)
FRONTEND_URL="http://localhost:5173"
